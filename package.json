{
  "name": "contracts",
  "private": true,
  "scripts": {
    "setup": "bash deploy/scripts/setup-tools.sh",
    "fmt": "forge fmt --root evm && cargo fmt --all --manifest-path solana/Cargo.toml",
    "deploy": "yarn workspace @pockless/deploy-cli deploy",
    "upgrade": "yarn workspace @pockless/deploy-cli upgrade",
    "immutable": "yarn workspace @pockless/deploy-cli immutable",
    "smoke:testnet": "yarn workspace @pockless/deploy-cli smoke:testnet"
  },
  "workspaces": [
    "sdk",
    "deploy",
    "recovery/cli",
    "recovery/web"
  ],
  "packageManager": "yarn@4.10.3"
}
