# Persistent production-only EVM deployer.
EVM_FOUNDRY_ACCOUNT=
EVM_FOUNDRY_PASSWORD=
EVM_DEPLOYER_ADDRESS=

# Persistent production-only Solana keypairs. Store paths here, never key contents.
# The funded fee payer is also the mainnet-beta upgrade/verification authority.
SOLANA_FEE_PAYER_KEYPAIR=
# Separate unfunded deployment-only keypair whose public key is the mainnet program ID.
SOLANA_PROGRAM_KEYPAIR=
