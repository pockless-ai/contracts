# Testnet RPC endpoints
BASE_SEPOLIA_RPC_URL=
SOLANA_DEVNET_RPC_URL=

# Official Circle USDC contract on Base Sepolia:
# https://developers.circle.com/stablecoins/usdc-contract-addresses
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Persistent testnet EVM deployer.
EVM_FOUNDRY_ACCOUNT=
EVM_FOUNDRY_PASSWORD=
EVM_DEPLOYER_ADDRESS=

# Persistent testnet-only Solana keypairs. Store paths here, never key contents.
# The funded fee payer is also the devnet upgrade/verification authority.
SOLANA_FEE_PAYER_KEYPAIR=
# Separate unfunded deployment-only keypair whose public key is the devnet program ID.
SOLANA_PROGRAM_KEYPAIR=
