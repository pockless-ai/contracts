BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BNB_RPC_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_MAINNET_RPC_URL=

# Base Sepolia USDC contract (required for testnet)
