# RPC endpoints from your infrastructure provider or the chain's public endpoint.
# Testnet requires BASE_SEPOLIA_RPC_URL and SOLANA_DEVNET_RPC_URL.
# Mainnet requires every remaining mainnet RPC URL.
BASE_SEPOLIA_RPC_URL=
ETHEREUM_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
POLYGON_RPC_URL=
BNB_RPC_URL=
SOLANA_DEVNET_RPC_URL=
SOLANA_MAINNET_RPC_URL=

# Official Circle USDC contract on Base Sepolia:
# https://developers.circle.com/stablecoins/usdc-contract-addresses
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Name of the encrypted Foundry keystore account created/imported with `cast wallet`.
EVM_FOUNDRY_ACCOUNT=
# Public 0x address printed by `cast wallet address --account <name>`.
EVM_DEPLOYER_ADDRESS=
# Etherscan V2 API key used for explorer source verification.
ETHERSCAN_API_KEY=

# Absolute path to the funded chmod-600 Solana keypair JSON file. Never put key contents
# here. This one wallet is both fee payer and upgrade/verification authority.
SOLANA_FEE_PAYER_KEYPAIR=
# Separate unfunded deployment-only keypair whose public key becomes the program ID.
SOLANA_PROGRAM_KEYPAIR=

# Public source repository used by solana-verify. The commit must already be pushed.
SOLANA_VERIFY_REPOSITORY_URL=https://github.com/pockless-ai/contracts

# Optional verification service and polling overrides; defaults normally need no changes.
SOLANA_VERIFY_STATUS_URL=https://verify.osec.io/status
SOLANA_VERIFY_TIMEOUT_SECONDS=1800
SOLANA_VERIFY_POLL_SECONDS=15
# Minimum authority balance used to upload verification metadata (0.05 SOL).
SOLANA_VERIFY_AUTHORITY_MIN_LAMPORTS=50000000
