# Paths to temporary chmod-600 Solana keypair files
SOLANA_FEE_PAYER_KEYPAIR=
SOLANA_UPGRADE_AUTHORITY_KEYPAIR=
SOLANA_PROGRAM_KEYPAIR=

# Public verification metadata
SOLANA_VERIFY_REPOSITORY_URL=
# Optional provider/polling overrides
SOLANA_VERIFY_STATUS_URL=https://verify.osec.io/status
SOLANA_VERIFY_TIMEOUT_SECONDS=1800
SOLANA_VERIFY_POLL_SECONDS=15
# Conservative balance held by the authority while it uploads verification data
SOLANA_VERIFY_AUTHORITY_MIN_LAMPORTS=50000000
