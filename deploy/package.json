{
  "name": "@pockless/deploy-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pockless-deploy": "./src/index.ts"
  },
  "scripts": {
    "deploy": "tsx src/index.ts deploy",
    "upgrade": "tsx src/index.ts upgrade",
    "immutable": "tsx src/index.ts immutable",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "smoke:testnet": "LIVE_SMOKE=1 tsx --test tests/smoke/testnet-contracts.test.ts"
  },
  "dependencies": {
    "@pockless/protocol-sdk": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4",
    "typescript": "^5"
  }
}
